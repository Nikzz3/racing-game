# Sunset Ridge Racing — local environment.
#
# Copy to `.env` and edit. Every variable has a working default, so the file is optional;
# only uncomment what you want to change. Values already present in the shell always win
# over this file (Node's env-file semantics), so CI, the e2e wrapper, and one-off
# overrides like `PORT=8090 npm run dev` keep working.
#
# Loaded by: server (server/src/env.ts), client dev server (client/vite.config.ts),
# desktop build (desktop/scripts/build.mjs), and the unpackaged desktop app.

# ── Server ───────────────────────────────────────────────────────────────────────────
# Postgres for rooms, best laps, and replays. Default matches `podman compose up -d`.
#DATABASE_URL=postgres://postgres:postgres@localhost:5432/racing
# HTTP + WebSocket port. `npm run dev` mirrors it into the client (VITE_SERVER_PORT).
#PORT=8080

# ── Client dev server ────────────────────────────────────────────────────────────────
# Vite port. Set it (together with PORT) to run a second checkout/worktree side by side.
#CLIENT_PORT=5173
# Normally derived from PORT; set explicitly only when the client dev server and the
# WebSocket server run on different machines.
#VITE_SERVER_PORT=8080

# ── Desktop (Electron) ───────────────────────────────────────────────────────────────
# WebSocket URL baked into `npm run desktop:build` and used by `npm run desktop:start`.
# Default is the local dev server; releases set the repository variable instead.
#RACING_SERVER_URL=ws://localhost:8080
# Open Chromium DevTools when the desktop app launches.
#RACING_DEVTOOLS=1

# ── Tests ────────────────────────────────────────────────────────────────────────────
# Disposable database for `npm run test -w server -- legacy-compatibility.test.ts`.
# The test refuses the developer `racing` database.
#LEGACY_COMPAT_DATABASE_URL=postgres://postgres:postgres@localhost:5432/racing_legacy

# ── End-to-end (npm run test:e2e) ────────────────────────────────────────────────────
# By default the wrapper starts a throwaway Postgres container and talks to Docker, or
# to the rootless Podman socket when Docker is absent. Override only when containers are
# unavailable: the suite TRUNCATES rooms, best_laps and replays in this database.
#E2E_DATABASE_URL=postgres://postgres:postgres@localhost:5432/racing_e2e
#E2E_DATABASE_ALLOW_TRUNCATE=1
# Ports for the suite's own server and client (defaults avoid the dev ports).
#E2E_SERVER_PORT=8081
#E2E_CLIENT_PORT=5174
# Container socket for testcontainers, e.g. a non-default Podman location.
#DOCKER_HOST=unix:///run/user/1000/podman/podman.sock
