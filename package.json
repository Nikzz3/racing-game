{
  "name": "racing-game",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client",
    "e2e",
    "desktop"
  ],
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npx tsx e2e/scripts/test-e2e.ts",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "desktop:build": "npm run build -w client -- --base=./ && npm run build -w desktop",
    "desktop:start": "npm run start -w desktop",
    "desktop:dist": "npm run dist -w desktop",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "jev:record": "tsx scripts/record-jev-lap.ts"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "concurrently": "^10.0.4",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "cpu-features@0.0.10": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true,
    "electron@44.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
